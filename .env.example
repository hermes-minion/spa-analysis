# Variables que espera el despliegue manual (npx wrangler deploy) y
# 009540/web/cf_setup_subdomain.py.
#
# Copia este fichero a .env (ignorado por git) y rellena el token real:
#   cp .env.example .env && chmod 600 .env
#   set -a; . ./.env; set +a          # exporta las variables en la shell
#
# Nunca se versiona el token: .env está en .gitignore y este ejemplo solo
# lleva marcadores.

# Cuenta 92cdc275ad658f9f2dd89c50d2296ebb (zone minion.dpdns.org).
CLOUDFLARE_ACCOUNT_ID=92cdc275ad658f9f2dd89c50d2296ebb

# Token de API de Cloudflare. Permisos necesarios según lo que se vaya a hacer:
#   - desplegar el Worker  -> Account: Workers Scripts : Edit
#   - cf_setup_subdomain.py -> Account: Cloudflare Tunnel : Edit + Zone: DNS : Edit
# Con un token de solo lectura, wrangler deploy devuelve 403
# "No access to the specified resource".
CLOUDFLARE_API_TOKEN=pon-tu-token-aqui
